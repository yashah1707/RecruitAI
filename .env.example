# Copy this file to .env and fill in your real key there.
# .env is gitignored -- it never gets committed or sent anywhere by this app.

# Required only when LLM_PROVIDER=gemini. Get a free key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides -- uncomment to change from the defaults in config.py
# LLM_PROVIDER=gemini
# GEMINI_MODEL=auto        # or pin: gemini-3.5-flash / gemini-3.6-flash / gemini-3.5-flash-lite

# --- the web application (backend/) ---------------------------------------
# DATABASE_URL=postgresql+psycopg://recruitai:recruitai@localhost:5432/recruitai

# Sending candidate emails (Gate 3). With no SMTP_HOST nothing can be sent.
# For Gmail: smtp.gmail.com, port 587, and an app password (not the account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# While testing: every email goes to this address as a test copy, never to a candidate.
# EMAIL_REDIRECT_TO=
# An acknowledgement of receipt goes to each applicant (see backend/emails.py). To turn it off:
# ACKNOWLEDGE_APPLICATIONS=false

# Reading applications from a mailbox. The login defaults to SMTP_USER / SMTP_PASSWORD,
# so with one account for both, only the host is needed. For Gmail: imap.gmail.com.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Addresses a Google Form response may come from, if not the mailbox's own (comma-separated).
# GOOGLE_FORM_SENDERS=
